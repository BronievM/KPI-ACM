<Window x:Class="LR3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR3" xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        mc:Ignorable="d" Title="LR3" Height="600" Width="1200" WindowStartupLocation="CenterScreen" Icon="/icons8-mathematics-lineal-color-96.png">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem Header="Зберегти дані розрахунки" Click="SaveToFile">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE792;" FontSize="14" Foreground="#0078D7"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Вихід" Click="ExitApp">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14" Foreground="#E81123"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Виконати...">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem Header="Тестова функція: sin(x)" Click="RunTestFunction">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" Foreground="#107C10"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Функція варіанту: exp(-(x+sin(x)))" Click="RunVariantFunction">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" Foreground="#D83B01"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Обчислити в точці x..." Click="EvaluatePoint">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" FontSize="14" Foreground="#107C10"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Відображення на графіку">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem x:Name="mnuModeInterpolation" Header="Графік інтерполяції" IsCheckable="True" IsChecked="True" Click="OnGraphModeMenuClick"/>
                <MenuItem x:Name="mnuModeError" Header="Графік похибки" IsCheckable="True" IsChecked="False" Click="OnGraphModeMenuClick"/>
            </MenuItem>
        </Menu>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text=" DEBUG CONSOLE" Foreground="#FFFFF906" FontSize="10" Margin="5,2"/>
                    <TextBox x:Name="txtLog" Background="Transparent" Foreground="#FFFFF906" 
                             BorderThickness="0" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                             FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <oxy:PlotView x:Name="plotView" Grid.Column="1" Background="White" Margin="5,0,0,0"/>
        </Grid>
    </DockPanel>
</Window>

