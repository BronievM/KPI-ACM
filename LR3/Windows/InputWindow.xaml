<Window x:Class="LR3.Windows.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR3.Windows"
        mc:Ignorable="d"
        Title="Введення" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="WidthAndHeight" MinWidth="250">
    <StackPanel Margin="10">
            <TextBlock x:Name="txtPrompt" Text="Введіть значення:"/>
            <TextBox x:Name="txtInput" Margin="0,10,0,10" Text="10"/>
            <Button Content="OK" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
</Window>
