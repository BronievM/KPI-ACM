<Window x:Class="LR2.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR2"
        mc:Ignorable="d"
       Title="Введення" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="WidthAndHeight" MinWidth="250" Icon="/icons8-info-120.png">
    <StackPanel Margin="10">
        <TextBlock x:Name="txtPrompt" Text="Введіть значення:"/>
        <TextBox x:Name="txtInput" Margin="0,10, 0, 10" Text="1000"/>
        <Button Content="ОК" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
</Window>