<Window x:Class="LR2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR2" xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        mc:Ignorable="d" Title="LR2" Height="600" Width="900" WindowStartupLocation="CenterScreen" Icon="/icons8-mathematics-lineal-color-96.png">
    
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem Header="Відкрити" Click="LoadFile">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" Foreground="#0078D7"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Зберегти відсортоване" Click="SaveToFile">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE792;" FontSize="14" Foreground="#0078D7"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Вихід" Click="ExitApp">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14" Foreground="#E81123"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Виконати...">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem Header="створення одного масиву..." Click="OpenInputWindow">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="14" Foreground="#107C10"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="повний аналіз..." Click="RunAnalysis">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" Foreground="#D83B01"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Налаштування">
                <MenuItem.Icon>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" Foreground="#333333"/>
                </MenuItem.Icon>
                <MenuItem x:Name="mnuShowOperations" Header="Відображати графік операцій" IsCheckable="True" IsChecked="True">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" Foreground="#0078D7"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text=" DEBUG CONSOLE" Foreground="#FFFFF906" FontSize="10" Margin="5,2"/>
                    <TextBox x:Name="txtLog" Background="Transparent" Foreground="#FFFFF906" 
                             BorderThickness="0" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                             FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <oxy:PlotView x:Name="plotView" Grid.Column="1" Background="White" Margin="5,0,0,0"/>
        </Grid>
    </DockPanel>
</Window>
