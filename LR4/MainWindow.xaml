<Window x:Class="LR4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR4" xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="LR4" Height="600" Width="1200" WindowStartupLocation="CenterScreen" Icon="/icons8-mathematics-lineal-color-96.png">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Зберегти звіт" Click="SaveToFile"/>
                <MenuItem Header="Вихід" Click="ExitApp"/>
            </MenuItem>
            <MenuItem Header="Розв'язати рівняння...">
                <MenuItem Header="Варіант 9: x^3 - x - 3 = 0" Click="RunVariantFunction"/>
            </MenuItem>
        </Menu>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DEBUG CONSOLE" Foreground="#FFFFF906" FontSize="10" Margin="5,2"/>
                    <TextBox x:Name="txtLog" Background="Transparent" Foreground="#FFFFF906" 
                             BorderThickness="0" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                             FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <oxy:PlotView x:Name="plotView" Grid.Column="1" Background="White" Margin="5,0,0,0"/>
        </Grid>
    </DockPanel>
</Window>