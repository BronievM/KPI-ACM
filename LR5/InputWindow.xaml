<Window x:Class="LR5.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введення даних" Height="450" Width="650" WindowStartupLocation="CenterOwner" Icon="/icons8-mathematics-lineal-color-96.png">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Розмір системи (N):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSize" Width="50" Text="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Button Content="Створити" Width="80" Margin="10,0,0,0" Click="BtnGenerateMatrix_Click"/>
            <Button Content="Завантажити матрицю з файлу" Margin="5,0,0,0" Click="BtnLoadFile_Click"/>
            <Button Content="Зберегти матрицю у файл" Margin="10,0,0,0" Click="BtnSaveFile_Click"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="MatrixGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Точність (Epsilon):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtEpsilon" Width="80" Text="0,0001" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Застосувати та розв'язати" Width="180" Height="30" Click="BtnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>